# Supabase — local only, DO NOT COMMIT (.env.local is gitignored)
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Local post-image moderation. Leave IMAGE_MODERATION_API_URL empty to use
# the free NSFWJS model on this server. A configured hosted provider receives
# the image bytes and must return { "result": "...", "reason": "..." }.
IMAGE_MODERATION_API_URL=
IMAGE_MODERATION_API_KEY=

# Development demo upload sessions. Replace these values for a local setup;
# DEMO_ADMIN_TOKEN is required to open /admin.
DEMO_SESSION_SECRET=replace-with-a-random-local-value
DEMO_ADMIN_TOKEN=replace-with-a-local-admin-token