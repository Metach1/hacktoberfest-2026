# Supabase configuration.
# Copy this file to .env.local and fill in the real values from your Supabase
# project: Dashboard -> Project Settings -> API.
#
# Both values are public by design: the browser client needs them, and your
# data is protected by Row Level Security (RLS) policies in Postgres, not by
# keeping these secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: The Supabase service_role key is intentionally NOT used by this app.
# It bypasses Row Level Security and must never be committed or exposed in the
# browser. Do not add it here.
