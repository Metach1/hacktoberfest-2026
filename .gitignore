# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# uploaded athlete photos (local dev only; never committed).
# The demo stores photos as in-browser data URLs in localStorage, so this
# folder is reserved for a future server-backed upload target. Local file
# storage is for development only — production must use object storage.
/public/uploads
/uploads

# typescript
*.tsbuildinfo
next-env.d.ts
